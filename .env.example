# Server-only. Never expose this to the browser.
# Never use NEXT_PUBLIC_OPENAI_API_KEY.
# Restart `npm run dev` after changing this file — Next.js reads it at process start.
# 1. Stop the development server.
# 2. Start it again with: npm run dev
OPENAI_API_KEY=

# Optional. All UI modes (Fast / Balanced / Advanced) use this unless overrides are set.
OPENAI_MODEL=gpt-4o-mini

# Optional per-mode overrides. Leave empty to share OPENAI_MODEL.
OPENAI_MODEL_FAST=
OPENAI_MODEL_BALANCED=
OPENAI_MODEL_ADVANCED=

# Optional image model. Defaults to dall-e-3 when OPENAI_API_KEY is set.
OPENAI_IMAGE_MODEL=dall-e-3

# Optional monthly cap overrides. Defaults live in lib/billing/plans.ts.
# FREE_MONTHLY_MESSAGES=50
# FREE_MONTHLY_IMAGES=5
# FREE_MONTHLY_DOCUMENTS=3
# FREE_MONTHLY_SEARCHES=10
# FREE_MONTHLY_VOICE_MINUTES=30

# Optional web search. Supported: tavily | brave | serper
# Leave empty to use the built-in DuckDuckGo + Wikipedia search (no key).
SEARCH_PROVIDER=
SEARCH_API_KEY=

# Optional TTS. Set TTS_PROVIDER=openai to use OPENAI_API_KEY for speech.
TTS_PROVIDER=
TTS_API_KEY=
OPENAI_TTS_MODEL=tts-1

# Optional email (not sent unless a provider is wired later)
EMAIL_PROVIDER=
EMAIL_API_KEY=

# Public Supabase values are safe for the browser, but still not secrets for admin access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Never put the service role key in NEXT_PUBLIC_* variables.
# SUPABASE_SERVICE_ROLE_KEY=

# Stripe TEST MODE only. Never put live keys here without an authorized adult/business owner.
# Never put Stripe secrets in NEXT_PUBLIC_*.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_PLUS_PRICE_ID=
STRIPE_PRO_MAX_PRICE_ID=
# Optional yearly prices. If empty, checkout falls back to the monthly price ID for that plan.
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_PRO_PLUS_YEARLY_PRICE_ID=
STRIPE_PRO_MAX_YEARLY_PRICE_ID=
